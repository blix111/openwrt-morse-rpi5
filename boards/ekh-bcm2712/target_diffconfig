CONFIG_TARGET_bcm27xx=y
CONFIG_TARGET_bcm27xx_bcm2712=y
CONFIG_TARGET_bcm27xx_bcm2712_DEVICE_rpi-5=y

# --- Image partition sizing ---
# Default 104 MB rootfs is far too small once Python3, Tailscale, ADS-B
# tools, and the LuCI stack are all installed. 512 MB gives comfortable
# headroom on modern SD cards.
CONFIG_TARGET_KERNEL_PARTSIZE=64
CONFIG_TARGET_ROOTFS_PARTSIZE=512

# --- Morse HaLow driver + firmware ---
CONFIG_PACKAGE_kmod-morse=y
CONFIG_PACKAGE_netifd-morse=y
CONFIG_PACKAGE_morsecli=y
CONFIG_PACKAGE_morse-fw-6108=y
CONFIG_PACKAGE_morse-fw-8108=y
CONFIG_PACKAGE_morse-board-config=y
CONFIG_PACKAGE_morse-regdb=y

# Driver bus support: SPI for the Seeed HAT path, SDIO retained for parity with Pi4
CONFIG_MORSE_SPI=y
CONFIG_MORSE_SDIO=y

# --- Pi 5 onboard 2.4/5 GHz Wi-Fi (BCM43455 via brcmfmac/SDIO) ---
# These are pulled in automatically by Device/rpi-5 DEVICE_PACKAGES, but
# selecting them explicitly here makes the dependency on regular Wi-Fi obvious
# in the diffconfig and survives any future Device/rpi-5 changes.
CONFIG_PACKAGE_kmod-brcmfmac=y
CONFIG_PACKAGE_cypress-firmware-43455-sdio=y
CONFIG_PACKAGE_brcmfmac-nvram-43455-sdio=y
CONFIG_PACKAGE_wpad-basic-mbedtls=y

# --- Panda Wireless / Ralink RT5370 USB dongle (rt2800usb) ---
CONFIG_PACKAGE_kmod-rt2800-usb=y

# --- mDNS responder (required by the Morse LuCI wizard for device discovery) ---
CONFIG_PACKAGE_umdns=y

# --- batman-adv layer-2 mesh (used by Haven mesh / setup-haven-point.sh) ---
CONFIG_PACKAGE_kmod-batman-adv=y
CONFIG_PACKAGE_batctl=y
CONFIG_PACKAGE_luci-proto-batman-adv=y

# --- S1G/HaLow auth stack ---
CONFIG_PACKAGE_hostapd_s1g=y
CONFIG_PACKAGE_wpa_supplicant_s1g=y

# --- 802.11s mesh ---
CONFIG_PACKAGE_morse_mesh11sd=y
CONFIG_PACKAGE_iw-full=y

# --- Morse bundle / scripts ---
CONFIG_PACKAGE_morse-bundle=y
CONFIG_PACKAGE_morse-mode=y
CONFIG_PACKAGE_wizard-config=y

# --- LuCI ---
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-app-morseconfig=y
CONFIG_PACKAGE_luci-app-morseapwizard=y
CONFIG_PACKAGE_luci-app-morseguide=y
CONFIG_PACKAGE_luci-app-morseupgrade=y
CONFIG_PACKAGE_luci-theme-morse=y
CONFIG_PACKAGE_luci-theme-morseargon=y
CONFIG_PACKAGE_luci-lib-morseui=y
CONFIG_PACKAGE_luci-mod-home=y

# --- ADS-B receive / dump1090 + adsbcot stack ---
CONFIG_PACKAGE_rtl-sdr=y
CONFIG_PACKAGE_librtlsdr=y
CONFIG_PACKAGE_dump1090=y
CONFIG_PACKAGE_python3=y
CONFIG_PACKAGE_python3-pip=y
# CONFIG_PACKAGE_python3-cryptography is not set
# Note: adsbcot itself is pip-only — install on-device with: pip3 install adsbcot

# --- Reticulum / mesh networking Python deps ---
# Note: python3-rns / python3-lxmf / python3-nomadnet are pip-only:
#   pip3 install rns lxmf nomadnet
CONFIG_PACKAGE_python3-pyserial=y
CONFIG_PACKAGE_python3-netifaces=y

# --- USB serial (LoRa / MCU sidecar boards) ---
CONFIG_PACKAGE_kmod-usb-acm=y
CONFIG_PACKAGE_kmod-usb-serial=y
CONFIG_PACKAGE_kmod-usb-serial-cp210x=y
CONFIG_PACKAGE_kmod-usb-serial-ch341=y
CONFIG_PACKAGE_kmod-usb-serial-ftdi=y

# --- Additional USB Wi-Fi dongle drivers ---
# kmod-rt2800-usb already enabled above (Panda RT5370)
# kmod-mt76x0u disabled: mt76 src (2024-04-03) is incompatible with kernel
# 6.6.133 + this backports vintage (nla_policy + set_tim signature mismatch).
# Re-enable after bumping mt76 to a 6.6-compatible snapshot, or after the
# Morse mac80211 patch backport pass is done.
# CONFIG_PACKAGE_kmod-mt76x0u=y
# Note: kmod-rtl8821cu (Realtek 0bda:0811) is out-of-tree, not in OpenWrt feeds.
# To add later: include a 3rd-party feed (e.g. morrownr/8821cu) and select here.

# --- Network debugging ---
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_mtr-nojson=y
CONFIG_PACKAGE_nmap=y
CONFIG_PACKAGE_usbutils=y

# --- General utilities ---
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_screen=y

# --- VPN / mesh-VPN ---
# WireGuard (kernel module + userspace tools + LuCI proto integration)
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_luci-proto-wireguard=y
# Tailscale (Go binary, ~30 MB; works with stock Tailscale or a self-hosted Headscale)
CONFIG_PACKAGE_tailscale=y
