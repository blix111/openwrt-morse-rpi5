From: Morse Micro <support@morsemicro.com>
Subject: mmc: sdio: add MMC_QUIRK_NO_18V for morse,mm610x SDIO HaLow cards

The MM6104 / MM6108 HaLow SDIO cards advertise R4_18V_PRESENT in their R4
response but do not actually support 1.8V signaling. Add an of_compatible
SDIO fixup that sets MMC_QUIRK_NO_18V on these devices and have the SDIO
init path skip mmc_set_uhs_voltage() when the quirk is set.

Refreshed against kernel 6.6: upstream has already absorbed the
SDIO_FIXUP_COMPATIBLE / sdio_card_init_methods / of_compatible
infrastructure that the original 5.15-era patch had to add. This patch
now only adds the missing MMC_QUIRK_NO_18V flag (bit 15 was reused for
BROKEN_SD_CACHE so we use bit 19), the morse,mm610x table entries, and
the 18V skip check in mmc_sdio_init_card().

Lives in target/linux/bcm27xx/patches-6.6/ rather than generic/pending-6.6/
because it must apply AFTER the bcm27xx donor patch
950-0092-MMC-added-alternative-MMC-driver.patch — that patch inserts
MMC_QUIRK_ERASE_BROKEN (1<<31) at the same point in card.h where we want
MMC_QUIRK_NO_18V (1<<19), so our hunk's post-context needs
MMC_QUIRK_ERASE_BROKEN to be present.

--- a/drivers/mmc/core/quirks.h
+++ b/drivers/mmc/core/quirks.h
@@ -204,6 +204,10 @@ static const struct mmc_fixup __maybe_u
 			      MMC_QUIRK_LENIENT_FN0 |
 			      MMC_QUIRK_BLKSZ_FOR_BYTE_MODE),

+	SDIO_FIXUP_COMPATIBLE("morse,mm6104", add_quirk, MMC_QUIRK_NO_18V),
+
+	SDIO_FIXUP_COMPATIBLE("morse,mm6108", add_quirk, MMC_QUIRK_NO_18V),
+
 	END_FIXUP
 };

--- a/drivers/mmc/core/sdio.c
+++ b/drivers/mmc/core/sdio.c
@@ -721,7 +721,7 @@ static int mmc_sdio_init_card(struct mm
 	 * try to init uhs card. sdio_read_cccr will take over this task
 	 * to make sure which speed mode should work.
 	 */
-	if (rocr & ocr & R4_18V_PRESENT) {
+	if ((rocr & ocr & R4_18V_PRESENT) && !(card->quirks & MMC_QUIRK_NO_18V)) {
 		err = mmc_set_uhs_voltage(host, ocr_card);
 		if (err == -EAGAIN) {
 			mmc_sdio_pre_init(host, ocr_card, card);
--- a/include/linux/mmc/card.h
+++ b/include/linux/mmc/card.h
@@ -298,7 +298,8 @@ struct mmc_card {
 #define MMC_QUIRK_BROKEN_CACHE_FLUSH	(1<<16)	/* Don't flush cache until the write has occurred */
 #define MMC_QUIRK_BROKEN_SD_POWEROFF_NOTIFY	(1<<17) /* Disable broken SD poweroff notify support */
 #define MMC_QUIRK_NO_UHS_DDR50_TUNING	(1<<18) /* Disable DDR50 tuning */
+#define MMC_QUIRK_NO_18V		(1<<19)	/* Ignore voltage negotiation and don't use 1.8v */
 #define MMC_QUIRK_WORKING_SD_CQ	(1<<30)		/* SD card has known-good CQ implementation */
 #define MMC_QUIRK_ERASE_BROKEN	(1<<31)		/* Skip erase */

 	bool			written_flag;
